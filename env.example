# PostgreSQL. On Neon or Supabase, DATABASE_URL is the pooled address and DIRECT_URL is the direct one.
# For a plain local database, use the same address for both.
DATABASE_URL="postgresql://raasta:raasta@localhost:5432/raasta"
DIRECT_URL="postgresql://raasta:raasta@localhost:5432/raasta"
APP_URL="http://localhost:3000"
# First admin account, created by `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password-now"
# Email (verification and password reset). Without SMTP_HOST, links print to the server console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="RAASTA <no-reply@yourdomain.com>"
# Product photos. Leave the S3_ values empty in local development to save to ./uploads.
# On Netlify they are required, or uploaded photos will be lost.
S3_ENDPOINT=""          # Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""        # the bucket's public address, e.g. https://pub-xxxx.r2.dev
UPLOAD_DIR="./uploads"
